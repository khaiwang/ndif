# Merged .env: upstream's NDIF_* schema + telemetry vars retained from
# the pre-merge dev .env (the new compose still references the
# telemetry/influx/jaeger/grafana names directly).

# -----------------------------------------------------------------------------
# Broker (Redis)
# -----------------------------------------------------------------------------
NDIF_BROKER_URL=redis://localhost:6379
NDIF_BROKER_PORT=6379
REDIS_VERSION=latest

# -----------------------------------------------------------------------------
# Object Store (MinIO/S3)
# -----------------------------------------------------------------------------
NDIF_OBJECT_STORE_URL=http://localhost:27018
NDIF_OBJECT_STORE_PORT=27018
NDIF_OBJECT_STORE_CONSOLE_PORT=46805
NDIF_OBJECT_STORE_SERVICE=s3
NDIF_OBJECT_STORE_BUCKET=ndif-results
NDIF_OBJECT_STORE_ACCESS_KEY=minioadmin
NDIF_OBJECT_STORE_SECRET_KEY=minioadmin
NDIF_OBJECT_STORE_REGION=us-east-1
NDIF_OBJECT_STORE_VERIFY=false
MINIO_VERSION=latest

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
NDIF_API_URL=http://localhost:5001
NDIF_API_PORT=5001
NDIF_API_WORKERS=1
NDIF_DEV_MODE=true
API_VERSION=latest

# -----------------------------------------------------------------------------
# Ray
# -----------------------------------------------------------------------------
NDIF_RAY_ADDRESS=ray://localhost:10001
NDIF_RAY_HEAD_PORT=6385
NDIF_RAY_CLIENT_PORT=10001
NDIF_RAY_DASHBOARD_PORT=8265
NDIF_RAY_SERVE_PORT=8262
NDIF_RAY_OBJECT_MANAGER_PORT=8076
NDIF_RAY_DASHBOARD_GRPC_PORT=8268
NDIF_RAY_TEMP_DIR=/tmp/ray
RAY_VERSION=latest

# -----------------------------------------------------------------------------
# Controller
# -----------------------------------------------------------------------------
NDIF_CONTROLLER_IMPORT_PATH=ndif.services.ray.deployments.controller.controller
NDIF_MINIMUM_DEPLOYMENT_TIME_SECONDS=0

# -----------------------------------------------------------------------------
# Telemetry — InfluxDB
# -----------------------------------------------------------------------------
DEV_INFLUXDB_PORT=8086
INFLUXDB_VERSION=2
INFLUXDB_ORG=NDIF
INFLUXDB_BUCKET=data
SECRET_INFLUXDB_ADMIN_USERNAME=admin
SECRET_INFLUXDB_ADMIN_PASSWORD=adminadmin
SECRET_INFLUXDB_ADMIN_TOKEN=njkldhsfbdsfkl2o32==

# -----------------------------------------------------------------------------
# Telemetry — Loki / Prometheus / Grafana
# -----------------------------------------------------------------------------
DEV_LOKI_PORT=3100
LOKI_VERSION=2.8.1
PROMETHEUS_VERSION=latest
GRAFANA_VERSION=latest
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Telemetry — Jaeger (OpenTelemetry)
# -----------------------------------------------------------------------------
JAEGER_VERSION=latest
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318

# -----------------------------------------------------------------------------
# Local nnsight bind-mount for VanillaBatchServer (cross-request batching).
# Once VanillaBatchServer ships in pypi nnsight, remove this and pin a
# version in src/services/ray/requirements.in instead.
# -----------------------------------------------------------------------------
NNSIGHT_PATH=/disk/u/zikai/nnsight/.claude/worktrees/hf-serve/src/nnsight

# -----------------------------------------------------------------------------
# Optional: cap actor in-flight requests. Default (32 in code) preserves
# batching by allowing many concurrent __call__ to fan into one fused
# forward pass. Setting to 1 forces every forward to bs=1 (useful for
# A/B testing batched vs sequential throughput).
# -----------------------------------------------------------------------------
# NDIF_MAX_CONCURRENCY=32
