# seqtest stack — NDIF_MAX_CONCURRENCY=1 forces single-in-flight per actor.
# Port set chosen to coexist with mripa's dev-* and the batchtest stack.

NDIF_BROKER_URL=redis://localhost:6381
NDIF_BROKER_PORT=6381
REDIS_VERSION=latest

NDIF_OBJECT_STORE_URL=http://localhost:27020
NDIF_OBJECT_STORE_PORT=27020
NDIF_OBJECT_STORE_CONSOLE_PORT=46807
NDIF_OBJECT_STORE_SERVICE=s3
NDIF_OBJECT_STORE_BUCKET=ndif-results
NDIF_OBJECT_STORE_ACCESS_KEY=minioadmin
NDIF_OBJECT_STORE_SECRET_KEY=minioadmin
NDIF_OBJECT_STORE_REGION=us-east-1
NDIF_OBJECT_STORE_VERIFY=false
MINIO_VERSION=latest

NDIF_API_URL=http://localhost:5003
NDIF_API_PORT=5003
NDIF_API_WORKERS=1
NDIF_DEV_MODE=true
API_VERSION=batchtest

NDIF_RAY_ADDRESS=ray://localhost:20003
NDIF_RAY_HEAD_PORT=6387
NDIF_RAY_CLIENT_PORT=20003
NDIF_RAY_DASHBOARD_PORT=8273
NDIF_RAY_SERVE_PORT=8274
NDIF_RAY_OBJECT_MANAGER_PORT=8078
NDIF_RAY_DASHBOARD_GRPC_PORT=8275
NDIF_RAY_TEMP_DIR=/tmp/ray
RAY_VERSION=batchtest

NDIF_CONTROLLER_IMPORT_PATH=src.ray.deployments.controller.controller
NDIF_MINIMUM_DEPLOYMENT_TIME_SECONDS=0

DEV_INFLUXDB_PORT=8088
INFLUXDB_VERSION=2
INFLUXDB_ORG=NDIF
INFLUXDB_BUCKET=data
SECRET_INFLUXDB_ADMIN_USERNAME=admin
SECRET_INFLUXDB_ADMIN_PASSWORD=adminadmin
SECRET_INFLUXDB_ADMIN_TOKEN=njkldhsfbdsfkl2o32==

DEV_LOKI_PORT=3102
LOKI_VERSION=2.8.1
PROMETHEUS_VERSION=latest
GRAFANA_VERSION=latest
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

JAEGER_VERSION=latest
JAEGER_UI_PORT=16688
JAEGER_OTLP_GRPC_PORT=4321
JAEGER_OTLP_HTTP_PORT=4322

