        <mxCell id="gpu2" value="&lt;b&gt;GPU 2&lt;/b&gt;&lt;br&gt;80GB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
