        <mxCell id="mem0_cpu0" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="cpu0" target="mem0"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- NVLink label -->
        <mxCell id="nvl0" value="NVLink" style="text;html=1;fontSize=9;align=center;fontColor=#82b366;" vertex="1" parent="1">
