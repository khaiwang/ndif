        <mxCell id="pcie0_gpu1" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="pcie0" target="gpu1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pcie0_gpu2" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="pcie0" target="gpu2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pcie0_gpu3" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="pcie0" target="gpu3"><mxGeometry relative="1" as="geometry"/></mxCell>
